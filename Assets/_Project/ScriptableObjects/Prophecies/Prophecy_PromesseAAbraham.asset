  m_Script: {fileID: 11500000, guid: 5c26e69bdfa54ba396b4e5771bd091f1, type: 3}
  m_Name: Prophecy_PromesseAAbraham
  m_EditorClassIdentifier:
  displayName: La Promesse Faite à Abraham
  age: 0
  reference: Genèse 12:1-3 ; 15:5
  prophecyText: >-
    L'Éternel dit à Abram : « Je ferai de toi une grande nation ... et toutes
    les familles de la terre seront bénies en toi. » Il le conduit ensuite sous
    les étoiles : « Telle sera ta postérité. »
  fulfillmentText: >-
    Une promesse à génération lente : d'un seul homme sans enfant naît un peuple
    innombrable, les tribus d'Israël qui portent cette histoire, âge après âge,
    jusqu'à la bénédiction promise à toutes les nations.
