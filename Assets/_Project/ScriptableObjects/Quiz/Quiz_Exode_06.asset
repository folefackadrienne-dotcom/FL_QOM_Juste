  questionId: "Exode_06"
  age: 1
  questionText: "Que promet Exode 33:14 au peuple inquiet après l'épisode du veau d'or ?"
  answers:
  - "\"Ma présence marchera avec toi\""
  - "\"Tu périras dans le désert\""
  - "\"Un autre te guidera\""
  - "\"Attends encore 40 ans\""
