  questionId: "Prophetes_03"
  age: 5
  questionText: "Que répond Élisée à son serviteur effrayé devant l'armée araméenne ?"
  answers:
  - "\"Fuyons\""
  - "\"Ceux qui sont avec nous sont plus nombreux qu'eux\""
  - "\"Rendons-nous\""
  - "\"Prions Baal\""
  correctAnswerIndex: 1
  sourceReference: "2 Rois 6:16"
  explanation: "Élisée rassure son serviteur juste avant que Dieu ouvre ses yeux sur l'armée céleste qui les entoure."
  faithReward: 6
  pointsReward: 2
