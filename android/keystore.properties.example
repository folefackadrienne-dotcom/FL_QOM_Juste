# Copie ce fichier en "keystore.properties" (jamais commité, voir .gitignore) pour signer
# les builds "release" en local. En CI, ces valeurs sont fournies via les secrets GitHub
# (voir .github/workflows/android-build.yml) qui génèrent ce fichier automatiquement.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=croque-versets
keyPassword=CHANGE_ME
